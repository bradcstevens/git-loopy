# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.*.local

# Node (kept so this template is safe to scaffold a Node app into)
node_modules/
dist/
build/
coverage/
.nyc_output/

# Python (kept so this template is safe to scaffold a Python app into)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version
*.egg-info/

# git-loopy runtime scratch
git-loopy/.tmp/

# git-loopy/python/ persisted observability artefacts (JSONL event logs +
# per-run summary JSONs; never commit).
.git-loopy/

# Project-local PRDs and issues for the legacy ISSUE_SOURCE=prds mode.
# GitHub Issues is the default in this kit; uncomment the lines below if you
# want to track local markdown issues in version control instead.
prds/
issues/

# Copilot CLI's own working tree. git-loopy reads Skills from the catalog it
# installs from the pin and from nowhere else (ADR-0025), so this repository
# tracks no `.copilot/` catalog (#340) -- only whatever a local Copilot CLI
# session happens to leave here, which is never committed.
.copilot/
.mypy_cache/
.pytest_cache/
.test-tmp/
.ruff_cache/

# Intake feature-request briefs (per-run capture from /intake; not tracked)
docs/feature-requests/

.reference/

# Nested git worktrees. These are gitlinks (mode 160000) with no .gitmodules
# entry, so committing one makes `actions/checkout` fail its submodule cleanup
# with "fatal: No url found for submodule path ... in .gitmodules".
.worktrees/

# Throwaway debugging scratch space (fake `gh` stubs, captured stdout/stderr).
.scratch/

# Captured stdout dropped in the repository root by an ad-hoc redirect, e.g.
# `gh issue view 343 --comments > out343.txt`. That belongs in `.scratch/`;
# rooted so a deliberate `out*.txt` fixture elsewhere in the tree stays visible.
/out*.txt

# Locally installed developer tooling (actionlint, cargo-dist). These are host
# binaries and `cargo install` bookkeeping: 29 MB of macOS-arm64 executables is
# useless to a Linux CI runner, which installs its own pinned copies. CI is the
# authority for tool versions (`.github/workflows/workflow-lint.yml` pins
# actionlint; `tui-release.yml` pins cargo-dist), so a checked-in binary could
# only ever disagree with it.
.tools/

# Rust build output. Scoped to the crate so an unrelated `target/` stays visible;
# `Cargo.lock` is tracked because git-loopy-tui ships as a binary.
/git-loopy/tui/target/

# Acquisitions of the pinned external Skill catalog (ADR-0023). `python -m
# git_loopy.skill_source` checks the pinned revision out here; it is a
# reproducible copy of an upstream commit, so committing it would only vendor
# the same content a third time.
.git-loopy/

WAYFINDER-MAP.md
OPERATIONAL-SURFACES.md