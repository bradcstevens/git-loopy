{
  "schema_version": 1,
  "contract_version": "1.5",
  "event_schema_version": "1.1",
  "insight_capabilities": {
    "names": [
      "agent_output",
      "structured_agent_events",
      "token_usage",
      "context_window",
      "skill_consultation",
      "cost"
    ],
    "orchestrators": {
      "python": {
        "agent_output": true,
        "structured_agent_events": true,
        "token_usage": true,
        "context_window": true,
        "skill_consultation": true,
        "cost": true
      },
      "shell": {
        "agent_output": true,
        "structured_agent_events": false,
        "token_usage": false,
        "context_window": false,
        "skill_consultation": false,
        "cost": false
      },
      "powershell": {
        "agent_output": true,
        "structured_agent_events": false,
        "token_usage": false,
        "context_window": false,
        "skill_consultation": false,
        "cost": false
      }
    }
  },
  "payload_contracts": {
    "wrapper.run.start": {
      "required": ["release_version", "schema_version", "insight_capabilities"]
    },
    "wrapper.issue.activated": {
      "required_when_present": ["issue", "activated_at", "binding_source"]
    },
    "agent.output": {
      "required_when_present": ["text", "kind"],
      "kind_values": ["unclassified"]
    },
    "usage.context_window": {
      "required_when_present": [
        "current_tokens",
        "token_limit",
        "effective_target_tokens",
        "effective_ceiling_tokens"
      ]
    },
    "wrapper.iteration.end": {
      "required_when_present": ["outcome", "duration_seconds", "summary", "issues"],
      "summary_required": [
        "model",
        "tokens_in",
        "tokens_out",
        "observed_tokens",
        "cost_usd",
        "tool_count",
        "skill_call_count",
        "skills_consulted",
        "commits",
        "auto_closures",
        "pr_advances",
        "strikes",
        "peak_context_window"
      ],
      "issue_required": [
        "issue",
        "status",
        "first_started_at",
        "closed_at",
        "issue_elapsed_seconds",
        "active_seconds",
        "cumulative_active_seconds",
        "consumption",
        "cost_usd",
        "peak_context_window"
      ],
      "consumption_required": ["model", "tokens_in", "tokens_out"]
    },
    "wrapper.skill_policy.resolved": {
      "required_when_present": [
        "base_scope",
        "enabled",
        "fallback",
        "legacy_denied",
        "migration_warning",
        "required",
        "source_kinds"
      ],
      "base_scope_values": ["project", "global", "minimal"],
      "fallback_values": ["minimal", "migration", null],
      "sorted_projections": ["enabled", "legacy_denied", "required", "source_kinds"],
      "redacted": "Skill identity is the canonical name: no absolute path, home directory, exposure directory, or Skill content may appear."
    },
    "wrapper.pool.refreshed": {
      "required_when_present": ["issues"],
      "emitted": "Only for a complete successful shallow snapshot. An incomplete pagination, an unresolved candidate, or a failed refresh emits nothing and cannot establish emptiness.",
      "order": "Source order, as read. The membership list is not re-sorted."
    },
    "wrapper.pool.excluded": {
      "required_when_present": ["issue", "title", "reason"],
      "reason_values": [
        "missing_what_to_build",
        "missing_acceptance_criteria",
        "missing_both_sections"
      ],
      "emitted": "Once per ready-for-agent candidate the AFK-ready discriminator rejected, in source order, before the wrapper.afk_ready.collected it explains. A candidate the source could not read is not an exclusion: it was never discriminated against.",
      "scope": "Run-scoped, not contribution-scoped. It names work that never became a Lane contribution, so it carries the collecting Iteration's iter and no contribution identity."
    },
    "wrapper.contribution.start": {
      "required_when_present": ["contribution_id", "issue", "lane_id"]
    },
    "wrapper.contribution.work_finished": {
      "required_when_present": ["contribution_id", "issue", "lane_id"]
    },
    "wrapper.integration.parked": {
      "required_when_present": ["contribution_id", "issue", "lane_id"]
    },
    "wrapper.integration.admitted": {
      "required_when_present": ["contribution_id", "issue", "lane_id"]
    },
    "wrapper.integration.started": {
      "required_when_present": ["contribution_id", "issue", "lane_id"]
    },
    "wrapper.integration.branch_observed": {
      "required_when_present": [
        "contribution_id",
        "issue",
        "lane_id",
        "base_publications_since_cut"
      ],
      "nullable": ["base_publications_since_cut"]
    },
    "wrapper.integration.recovery_started": {
      "required_when_present": [
        "contribution_id",
        "issue",
        "lane_id",
        "attempt",
        "max_attempts"
      ]
    },
    "wrapper.integration.published": {
      "required_when_present": ["contribution_id", "issue", "lane_id"]
    },
    "wrapper.contribution.end": {
      "required_when_present": [
        "contribution_id",
        "issue",
        "lane_id",
        "published",
        "reason",
        "summary"
      ],
      "reason_values": [
        "published",
        "unchanged_branch",
        "checkpoint_failed",
        "serial_fallback"
      ],
      "summary_required": [
        "model",
        "effort",
        "tokens_in",
        "tokens_out",
        "observed_tokens",
        "cost_usd",
        "commits",
        "closures",
        "closure_outcome",
        "recovery_attempts",
        "agent_seconds",
        "lifecycle_seconds",
        "peak_context_window",
        "strike_reaction"
      ],
      "strike_reaction_values": ["reset", "+1"],
      "emitted": "The authoritative finalized Parallel row and Strike transition. A publication that has not yet verified its closure is not a contribution end.",
      "counted_once": "Lane-work and recovery Consumption and commits appear exactly once, in the originating contribution. Runner Checkpoint commits are excluded from the commit total."
    },
    "wrapper.concurrency.changed": {
      "required_when_present": [
        "configured_lane_limit",
        "effective_lane_limit",
        "pressure",
        "rate_limit_state",
        "credit_state",
        "host_state"
      ],
      "nullable": ["pressure", "rate_limit_state", "credit_state", "host_state"],
      "pressure_values": [
        "integration_backlog",
        "rate_limit",
        "credit",
        "host",
        null
      ],
      "emitted": "Only for an authoritative effective-limit transition, never per observation. The configured Lane cap is immutable for the Run.",
      "unavailable": "A signal the Run cannot observe is null, never an estimated or zero value."
    },
    "wrapper.serial.requested": {
      "required_when_present": ["issue", "reason"],
      "nullable": ["issue"],
      "reason_values": ["validated_serial_candidate", "integration_fallback"]
    },
    "wrapper.pipeline.quiescent": {
      "required_when_present": ["phase", "reason"],
      "phase_values": [
        "draining_for_serial",
        "serial_ownership",
        "rolling_refill_turn",
        "iteration_cap_drain",
        "abort_drain"
      ]
    },
    "wrapper.rolling.refill_turn": {
      "required_when_present": ["reservations", "effective_lane_limit"]
    }
  },
  "contribution_identity": {
    "keys": ["contribution_id", "issue", "lane_id"],
    "iter": null,
    "lifecycle_types": [
      "wrapper.contribution.start",
      "wrapper.contribution.work_finished",
      "wrapper.contribution.end",
      "wrapper.integration.parked",
      "wrapper.integration.admitted",
      "wrapper.integration.started",
      "wrapper.integration.branch_observed",
      "wrapper.integration.recovery_started",
      "wrapper.integration.published"
    ],
    "stamped_types": [
      "agent.output",
      "assistant.message",
      "assistant.reasoning",
      "tool.call",
      "tool.result",
      "usage.context_window",
      "usage.tokens",
      "wrapper.auto_close",
      "wrapper.checkpoint.recorded",
      "wrapper.commit.recorded"
    ],
    "scheduler_scoped_types": [
      "wrapper.pool.refreshed",
      "wrapper.pool.excluded",
      "wrapper.concurrency.changed",
      "wrapper.serial.requested",
      "wrapper.pipeline.quiescent",
      "wrapper.rolling.refill_turn"
    ],
    "forbidden_types": ["wrapper.iteration.start", "wrapper.iteration.end"],
    "lane_id": "The reusable Lane the contribution started in. It never changes, even after that Lane is refilled, so replay never needs a mutable Lane-to-issue lookup.",
    "legacy": "Historical Wave traces carry lane_issue and no contribution identity. They remain readable and MUST NOT be reinterpreted as contributions."
  },
  "value_semantics": {
    "unknown": null,
    "observed_none": {
      "counter": 0,
      "collection": []
    },
    "timestamp_format": "RFC3339 UTC with trailing Z",
    "duration_source": "monotonic clock",
    "duration_unit": "seconds"
  },
