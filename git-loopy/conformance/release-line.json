{
  "schema_version": 2,
  "contract_version": "2.0",
  "distributions": ["python", "shell", "powershell"],
  "bump_class_taxonomy": [
    "major",
    "minor",
    "patch",
    "none"
  ],
  "cases": [
    {
      "id": "major-bump",
      "labels": ["ready-for-agent", "semver:major"],
      "bump_class": "major"
    },
    {
      "id": "minor-bump",
      "labels": ["semver:minor"],
      "bump_class": "minor"
    },
    {
      "id": "patch-bump",
      "labels": ["task-type:bugfix", "semver:patch"],
      "bump_class": "patch"
    },
    {
      "id": "none-is-a-deliberate-no-bump",
      "labels": ["semver:none"],
      "bump_class": "none"
    }
  ],
  "refusal_cases": [
    {
      "id": "unknown-key-is-refused",
      "labels": ["semver:prepatch"],
      "reason": "unknown_semver_key",
      "key": "prepatch"
    },
    {
      "id": "unknown-key-beside-a-known-key-is-still-refused",
      "labels": ["semver:patch", "semver:prepatch"],
      "reason": "unknown_semver_key",
      "key": "prepatch"
    },
    {
      "id": "recased-key-is-refused",
      "labels": ["semver:Minor"],
      "reason": "unknown_semver_key",
      "key": "Minor"
    },
    {
      "id": "bare-prefix-is-refused",
      "labels": ["semver:"],
      "reason": "unknown_semver_key",
      "key": ""
    },
    {
      "id": "missing-label-is-unclassified",
      "labels": ["ready-for-agent"],
      "reason": "unclassified_bump_class"
    },
    {
      "id": "two-known-labels-are-conflicting",
      "labels": ["semver:major", "semver:minor"],
      "reason": "conflicting_semver_labels",
      "keys": ["major", "minor"]
    },
    {
      "id": "none-beside-a-bump-is-conflicting",
      "labels": ["semver:none", "semver:patch"],
      "reason": "conflicting_semver_labels",
      "keys": ["none", "patch"]
    }
  ],
  "ratchet_cases": [
    {
      "id": "patch-raises-the-stable-target",
      "distributions": ["python"],
      "last_stable_version": "0.9.1",
      "prior_bump_classes": [],
      "current_target": "0.9.1",
      "bump_class": "patch",
      "new_target": "0.9.2"
    },
    {
      "id": "minor-raises-the-stable-target",
      "distributions": ["python"],
      "last_stable_version": "0.9.1",
      "prior_bump_classes": [],
      "current_target": "0.9.1",
      "bump_class": "minor",
      "new_target": "0.10.0"
    },
    {
      "id": "minor-ratchets-over-an-earlier-patch",
      "distributions": ["python"],
      "last_stable_version": "0.9.1",
      "prior_bump_classes": ["patch"],
      "current_target": "0.9.2",
      "bump_class": "minor",
      "new_target": "0.10.0"
    },
    {
      "id": "major-ratchets-over-an-earlier-minor",
      "distributions": ["python"],
      "last_stable_version": "0.9.1",
      "prior_bump_classes": ["minor"],
      "current_target": "0.10.0",
      "bump_class": "major",
      "new_target": "1.0.0"
    },
    {
      "id": "none-never-lowers-the-target",
      "distributions": ["python"],
      "last_stable_version": "0.9.1",
      "prior_bump_classes": ["minor"],
      "current_target": "0.10.0",
      "bump_class": "none",
      "new_target": "0.10.0"
    }
  ],
  "counter_cases": [
    {
      "id": "none-advances-neither-target-nor-counter",
      "distributions": ["python"],
      "last_stable_version": "0.9.1",
      "closed_bump_classes": ["none"],
      "expected": {
        "target": "0.9.1",
        "dev_counter": 0,
        "version": "0.9.1"
      }
    },
    {
      "id": "counter-counts-every-bumping-closure",
      "distributions": ["python"],
      "last_stable_version": "0.9.1",
      "closed_bump_classes": ["patch", "patch", "minor", "none"],
      "expected": {
        "target": "0.10.0",
        "dev_counter": 3,
        "version": "0.10.0-dev.3"
      }
    }
  ],
  "order_independence_cases": [
    {
      "id": "minor-and-two-patches-have-one-release-line",
      "distributions": ["python"],
      "last_stable_version": "0.9.1",
      "integration_orders": [
        ["patch", "patch", "minor"],
        ["minor", "patch", "patch"],
        ["patch", "minor", "patch"]
      ],
      "expected": {
        "target": "0.10.0",
        "dev_counter": 3,
        "version": "0.10.0-dev.3"
      }
    }
  ]
}
