{
  "schema_version": 1,
  "contract_version": "2.14",
  "pin_reads": [
    "bound",
    "refused",
    "unread"
  ],
  "covers": {
    "a": "Bound once and still open: the next Pickup orders it by section 3.2 and reports order",
    "b": "Passed over as Blocked: never promoted again, including after it unblocks",
    "c": "Unread: promoted again at the next Pickup, and bound as pin",
    "d": "Absent from a complete read: ordered like any other issue if it comes back",
    "e": "Absent from an incomplete read: still live",
    "f": "A spent Pin labelled priority: reports priority"
  },
