      "verdict": "accepted"
    },
    {
      "id": "a-model-with-no-effort-dial-takes-no-effort",
      "note": "`efforts: null` and a route naming no effort agree: the session is opened with no effort argument at all.",
      "harness": [{"model": "synthetic-effortless-0", "eligible": true, "efforts": null, "context_tiers": ["default"]}],
      "route": {"model": "synthetic-effortless-0", "reasoning_effort": null, "context_tier": "default"},
      "verdict": "accepted"
    },
    {
      "id": "the-effort-value-none-is-a-value-not-an-absent-dial",
      "note": "This model's dial OFFERS `none`, so `none` is sent as a value; the case above sends nothing. Collapsing the two is the bug.",
      "harness": [{"model": "synthetic-nonable-3", "eligible": true, "efforts": ["none", "low", "high"], "context_tiers": ["default"]}],
      "route": {"model": "synthetic-nonable-3", "reasoning_effort": "none", "context_tier": "default"},
      "verdict": "accepted"
    },
    {
      "id": "a-harness-that-could-not-be-asked-refuses-the-route",
