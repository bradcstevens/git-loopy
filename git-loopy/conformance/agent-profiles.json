  "permission_cases": [
    {
      "id": "agent-and-subagents-cannot-read-history",
      "deny_tools": [],
      "requests": [
        {"kind": "custom-tool", "tool_name": "session_store_sql", "tool_call_id": "agent-history-1"},
        {"kind": "custom-tool", "tool_name": "session_store_sql", "tool_call_id": "subagent-history-1"},
        {"kind": "hook", "tool_name": "session_store_sql", "tool_call_id": "subagent-history-2"},
        {"kind": "custom-tool", "tool_name": "session_store_sql", "tool_call_id": "agent-history-2"}
      ],
      "expected_decision": "reject",
      "expected_event": "tool.permission_denied",
      "expected_reason": "cross_session_history_disabled"
    },
    {
      "id": "history-refusal-is-not-an-operator-deny",
      "deny_tools": ["session_store_sql"],
      "requests": [
        {"kind": "custom-tool", "tool_name": "session_store_sql", "tool_call_id": "history-also-denied"}
      ],
      "expected_decision": "reject",
      "expected_event": "tool.permission_denied",
      "expected_reason": "cross_session_history_disabled"
    },
    {
      "id": "ordinary-tool-stays-approved",
      "deny_tools": [],
      "requests": [
        {"kind": "custom-tool", "tool_name": "edit", "tool_call_id": "ordinary-edit"}
      ],
      "expected_decision": "approve-once",
      "expected_event": "tool.permission_requested",
      "expected_reason": null
    }
