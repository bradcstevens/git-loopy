            "checkpoints_in_iter": 0,
            "pr_advances_in_iter": 0,
            "saw_nmt_sentinel": false
          },
          "expected": {
            "progress": true,
            "strikes": 0,
            "outcome": "running"
          }
        }
      ]
    },
