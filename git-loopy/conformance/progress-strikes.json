{
  "schema_version": 3,
  "contract_version": "2.10",
  "note": "Schema 3 separates Python's monotonic per-issue Strike accounting from its Abandonment guard (ADR-0061). Python-only cases use max_consecutive_abandonments, issue_status and expected.consecutive_abandonments; a Closed or advanced issue resets only the guard, including during a drain. Signals still drive the independent progress predicate. The schema-2 distributions selector and issues_skipped lifecycle fact are retained. Shell and PowerShell keep their unchanged consecutive unproductive-Iteration cases and max_strikes.",
  "distributions": ["python", "shell", "powershell"],
  "cases": [
    {
      "id": "agent-commit-is-progress",
      "max_strikes": 3,
      "steps": [
        {
          "signals": {
            "commits_in_iter": 1,
            "auto_closures_in_iter": 0,
            "checkpoints_in_iter": 0,
            "pr_advances_in_iter": 0,
            "saw_nmt_sentinel": false
          },
          "expected": {
            "progress": true,
            "strikes": 0,
            "outcome": "running"
          }
        }
      ]
    },
